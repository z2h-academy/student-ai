# Model Base
MODEL_BASE=microsoft/phi-2
HUGGINGFACE_TOKEN=hf_your_token_here

# Ollama
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=microsoft/phi-2

# Fine-tuning
FINETUNE_DATA_PATH=../1-triage/gold/amazon_reviews
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
MAX_SEQ_LENGTH=512
NUM_EPOCHS=3
BATCH_SIZE=4
LEARNING_RATE=2e-4
GRADIENT_ACCUMULATION=4

# Precision
FP16=false
BF16=false

# vLLM Server
VLLM_HOST=0.0.0.0
VLLM_PORT=8080
VLLM_MAX_MODEL_LEN=4096
VLLM_TENSOR_PARALLEL=1
VLLM_GPU_MEMORY=0.9
