# PostgreSQL
POSTGRES_HOST=postgres-container
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme1234

# Observability
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
METRICS_PORT=9091

# AI Services
OLLAMA_ENDPOINT=http://ollama:11434

# Guardrails
GUARDRAIL_MAX_PROMPT_LENGTH=8000
GUARDRAIL_MIN_PROMPT_LENGTH=1
GUARDRAIL_MAX_OUTPUT_LENGTH=16000
GUARDRAIL_MIN_SOURCE_CONFIDENCE=0.3

# Alertas
ALERT_QUALITY_THRESHOLD=0.7
ALERT_DRIFT_THRESHOLD=0.3
ALERT_ERROR_RATE_THRESHOLD=0.05
ALERT_LATENCY_THRESHOLD=5.0
