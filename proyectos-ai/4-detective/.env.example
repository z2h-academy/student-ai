# PostgreSQL (postgres-container:5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme1234
POSTGRES_DB=postgres

# Ollama (default LLM for agents)
OLLAMA_ENDPOINT=http://localhost:11434
MODEL_NAME=llama3.2

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minio-access-key
MINIO_ROOT_PASSWORD=minio-secret-key

# Helmet API (P3) — optional, uses Ollama directly if not set
# HELMET_API_URL=http://localhost:8000

# ChromaDB persistence (P2)
CHROMA_PERSIST_DIR=./chroma_db

# Escalation confidence threshold (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.6
