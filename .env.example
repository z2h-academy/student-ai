# ============================================
# AI Engineering Roadmap — Variables de entorno
# Copia este archivo como .env y ajusta valores
# ============================================

# OpenAI API Key (Level 1+)
OPENAI_API_KEY=

# Anthropic API Key (Level 1+)
ANTHROPIC_API_KEY=

# OpenCode Go — suscripcion open-weight (Level 1, section 7)
# https://opencode.ai/go
OPENCODE_GO_API_KEY=

# Patron OpenAI-compatible (Level 1, section 7)
# El mismo codigo corre contra cualquier proveedor. Descomenta UNA:
# Opcion A: OpenCode Go
# OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
# OPENAI_MODEL=deepseek-v4-flash
# Opcion B: OpenAI
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Opcion C: Ollama local
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2

# Anthropic model (Level 1, section 8) — el mas economico
# ANTHROPIC_MODEL=claude-haiku-4-5

# PostgreSQL compartida
PG_USER=postgres
PG_PASSWORD=changeme1234
PG_HOST=localhost
PG_PORT=5432
PG_DB=postgres

# MinIO (S3-compatible)
MINIO_ROOT_USER=minio-access-key
MINIO_ROOT_PASSWORD=minio-secret-key
MINIO_ENDPOINT=localhost:9000

# Ollama
OLLAMA_HOST=http://localhost:11434
